# TaskFlow Backend - Variables d'environnement
#
# En local, rien n'est obligatoire : sans DATABASE_URL, le backend utilise
# une base SQLite (fichier taskflow.db) à partir du TP 3.
#
# En production (TP 3), ces variables se définissent dans Render
# (taskflow-backend → Environment), jamais dans un fichier commité.

# Base de données Supabase (TP 3, exercice 6) - mode "Session pooler" :
# DATABASE_URL=postgresql://postgres.xxxx:MotDePasse@aws-0-eu-west-1.pooler.supabase.com:5432/postgres

# Origines autorisées à appeler l'API (séparées par des virgules) :
# - en local : le serveur de développement Vite
# - en production : l'URL de VOTRE frontend Render, sans "/" final
CORS_ORIGINS=http://localhost:3000
# CORS_ORIGINS=https://taskflow-frontend-xxxx.onrender.com
